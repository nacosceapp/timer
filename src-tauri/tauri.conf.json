{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NAC OSCE Timer",
  "version": "0.1.7",
  "identifier": "ca.nacosce.timer",
  "build": {
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NAC OSCE Timer",
        "width": 520,
        "height": 820,
        "minWidth": 180,
        "minHeight": 72,
        "resizable": true,
        "center": true,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": false,
        "fullscreen": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../app/icon.png"],
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
